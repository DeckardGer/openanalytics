# Toolchain pins are contract, not preference (docs/snapshot 04, Milestone 0).
# An install on the wrong Node major must fail loudly instead of producing a
# lockfile that only reproduces on one machine.
engine-strict=true

# Workspace packages always resolve to the local source of truth.
link-workspace-packages=true
prefer-workspace-packages=true
save-workspace-protocol=rolling

# Deterministic installs. CI additionally runs with --frozen-lockfile.
resolution-mode=highest
auto-install-peers=true
strict-peer-dependencies=false
