node_modules/
dist/
coverage/

# Tracker bundle: build output, measured in CI by scripts/build-tracker.mjs
apps/tracker/bundle/
*.tsbuildinfo

.env
.env.*
!.env.example

# Self-host: everything infra/selfhost/generate-secrets.sh writes. The templates
# beside them are committed; the filled-in copies carry every secret the
# deployment has.
infra/selfhost/env/*.env
!infra/selfhost/env/*.env.example
infra/selfhost/docker-compose.override.yml
# Snapshots written by infra/selfhost/snapshot.sh: both data volumes plus a copy
# of every secret above, which is what makes them restorable and what makes a
# committed one a full disclosure.
infra/selfhost/backups/
# The GeoIP database itself is never committed: ~60 MB, stale within a month,
# and MaxMind's may not be redistributed at all. The fetcher and the note that
# explains the directory are.
infra/selfhost/geoip/*
!infra/selfhost/geoip/.gitkeep
!infra/selfhost/geoip/fetch-dbip.sh

.DS_Store
Thumbs.db

.vitest/
.eslintcache

# Vercel CLI link state (per-machine)
.vercel/

# Claude Code permissions, per-machine and not part of the project
.claude/settings.local.json
