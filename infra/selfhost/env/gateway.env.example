# apps/query-gateway — the only process allowed to read ClickHouse.
#
# LEAVE UNUSED VARIABLES COMMENTED OUT, never blank — see api.env.example.
#
# It verifies an Ed25519-signed query envelope and runs allow-listed SELECTs.
# QUERY_SIGNING_PRIVATE_KEY is on its FORBIDDEN list: holding it would let the
# gateway forge the very requests it exists to authenticate. So are DATABASE_URL
# and the ingest, migration and maintenance ClickHouse credentials — deletion
# structurally cannot go through a SELECT allowlist, and the credential that
# could bypass it does not belong here.

NODE_ENV=production
# Must MATCH the api's ENVIRONMENT — see the note in api.env.example.
ENVIRONMENT=production
LOG_LEVEL=info
PORT=8081

CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_READ_USER=oa_read
CLICKHOUSE_READ_PASSWORD={{CLICKHOUSE_READ_PASSWORD}}

# The shared nonce store. Unset, replay defence is per-process, which is wrong
# for any deployment running more than one gateway instance — it warns and
# carries on. This one is read with a plain client, so a service name would work
# here; it uses the same address as everything else for consistency.
REALTIME_CACHE_REDIS_URL=redis://:{{VALKEY_REALTIME_PASSWORD}}@{{VALKEY_REALTIME_IP}}:6379

# Pins which key id may sign. Must match the api's QUERY_SIGNING_KEY_ID.
QUERY_SIGNING_KEY_ID=oa-selfhost-1
# Leave unset unless you set it on the api too — both default to
# `query-gateway:<ENVIRONMENT>`.
# QUERY_GATEWAY_AUDIENCE=

# The PUBLIC verify half is a PEM and lives as a block scalar in
# docker-compose.override.yml.

# METRICS_REMOTE_WRITE_URL=
# METRICS_REMOTE_WRITE_USER=
# METRICS_REMOTE_WRITE_TOKEN=
