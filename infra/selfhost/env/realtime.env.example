# apps/realtime — the SSE stream behind the live dashboard.
#
# LEAVE UNUSED VARIABLES COMMENTED OUT, never blank — see api.env.example.
#
# It holds presence state and nothing durable. REALTIME_TOKEN_SIGNING_KEY is on
# its FORBIDDEN list — it verifies tokens the api mints and can never mint one —
# along with DATABASE_URL, every ClickHouse and Stripe credential, AUTH_SECRET
# and the mail transports.

NODE_ENV=production
ENVIRONMENT=production
LOG_LEVEL=info
PORT=8084

# ADDRESSED BY IP, NOT BY SERVICE NAME — see note 2 in docker-compose.yml.
REALTIME_CACHE_REDIS_URL=redis://:{{VALKEY_REALTIME_PASSWORD}}@{{VALKEY_REALTIME_IP}}:6379

# The PUBLIC verify half of the realtime token pair is a PEM and lives as a
# block scalar in docker-compose.override.yml.

# METRICS_REMOTE_WRITE_URL=
# METRICS_REMOTE_WRITE_USER=
# METRICS_REMOTE_WRITE_TOKEN=
