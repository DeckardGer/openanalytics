# apps/web — the dashboard.
#
# THESE THREE ARE THE ORIGINS THE VISITOR'S BROWSER CALLS, and this file is the
# only place they are set.
#
# Next.js inlines every NEXT_PUBLIC_* value into the client bundle at build
# time, so the image is built against placeholder origins under `.invalid` and
# the container's entrypoint substitutes these into the built output before the
# server starts. That is what lets one published image serve any deployment —
# and it means changing a hostname is a restart, not a rebuild:
#   docker compose up -d --force-recreate web
#
# Each must be a bare origin — scheme, host, optional port, no path and no
# trailing slash. The entrypoint refuses to start on anything else rather than
# serve a dashboard that calls a URL nobody intended.
NEXT_PUBLIC_API_URL={{AUTH_BASE_URL}}
NEXT_PUBLIC_REALTIME_URL={{REALTIME_BASE_URL}}
NEXT_PUBLIC_COLLECTOR_URL={{COLLECTOR_BASE_URL}}

PORT=3000
NODE_ENV=production
