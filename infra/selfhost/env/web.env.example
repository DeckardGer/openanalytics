# apps/web — the dashboard.
#
# These three are ALSO build arguments, and the build-time copy is the one that
# matters for anything the browser does: Next.js inlines every NEXT_PUBLIC_*
# value into the client bundle. They are repeated here for the server-rendered
# half of the app. `./generate-secrets.sh` writes the same values into
# `infra/selfhost/.env`, which is where the compose file reads the build args
# from.
#
# CHANGING A HOSTNAME MEANS REBUILDING THIS IMAGE, not restarting the container:
#   docker compose build web && docker compose up -d web
NEXT_PUBLIC_API_URL={{AUTH_BASE_URL}}
NEXT_PUBLIC_REALTIME_URL={{REALTIME_BASE_URL}}
NEXT_PUBLIC_COLLECTOR_URL={{COLLECTOR_BASE_URL}}

PORT=3000
NODE_ENV=production
