# apps/worker — the queue drain, session finalizer, rollups, mail delivery,
# deletion executor.
#
# LEAVE UNUSED VARIABLES COMMENTED OUT, never blank — see api.env.example.
#
# It is the only writer of analytics rows and the only holder of the ClickHouse
# credentials that can insert or delete. AUTH_SECRET, QUERY_SIGNING_PRIVATE_KEY,
# CLICKHOUSE_MIGRATION_PASSWORD, STRIPE_WEBHOOK_SECRET, the OAuth client
# secrets, TRIAL_IDENTITY_SECRET, CREDENTIAL_SOURCE_SECRET and OPENAI_API_KEY
# are on its FORBIDDEN list and it exits at startup if handed one. Losing the
# webhook secret is what keeps it from becoming a second writer of entitlement
# state.

NODE_ENV=production
ENVIRONMENT=production
LOG_LEVEL=info
PORT=8085

DATABASE_URL=postgres://openanalytics:{{POSTGRES_PASSWORD}}@postgres:5432/openanalytics

# The worker's queue hop has no transport restriction (it is the consumer, not
# the public writer), but it uses the same addresses so there is one answer to
# "where is the queue".
EVENT_STREAM_REDIS_URL=redis://:{{VALKEY_QUEUE_PASSWORD}}@{{VALKEY_QUEUE_IP}}:6379
REALTIME_CACHE_REDIS_URL=redis://:{{VALKEY_REALTIME_PASSWORD}}@{{VALKEY_REALTIME_IP}}:6379

# --- ClickHouse -------------------------------------------------------------
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_INGEST_USER=oa_ingest
CLICKHOUSE_INGEST_PASSWORD={{CLICKHOUSE_INGEST_PASSWORD}}
# Site and account deletion runs on its own credential: ALTER DELETE and SELECT
# on analytics.*, and nothing else. Deliberately not the ingest user (which must
# stay insert-only) and not the migration user (which can also DROP tables, a
# privilege no long-running process should hold). WITHOUT IT, DELETION REQUESTS
# QUEUE AND RETRY FOREVER instead of erasing anything — a wait, not a loss, but
# a wait nobody is watching.
CLICKHOUSE_MAINTENANCE_USER=oa_maintenance
CLICKHOUSE_MAINTENANCE_PASSWORD={{CLICKHOUSE_MAINTENANCE_PASSWORD}}

# --- identity ---------------------------------------------------------------
# MUST BE THE SAME VALUE AND VERSION AS THE COLLECTOR'S. Used read-only here, to
# hash provider-side identifiers so a revenue fact joins against the event
# stream byte for byte. A different value joins against nothing while looking
# exactly like a value that should.
ANONYMOUS_IDENTITY_SECRET={{ANONYMOUS_IDENTITY_SECRET}}
ANONYMOUS_IDENTITY_KEY_VERSION=1

# Decrypts customers' own payment-provider keys. MUST BE BYTE-IDENTICAL to the
# api's copy.
OA_CREDENTIAL_KEYRING={{OA_CREDENTIAL_KEYRING}}

PRODUCT_NAME=Open Analytics

# --- mail -------------------------------------------------------------------
# Delivery is a worker job: the api only writes the send to the outbox. WITH NO
# TRANSPORT CONFIGURED, MAIL IS WRITTEN TO THE LOG AND NEVER SENT — which means
# magic-link sign-in cannot complete and invitations never arrive. Configure a
# transport, or bootstrap the first account with the create-admin script.
EMAIL_FROM=Open Analytics <analytics@analytics.example>

# SMTP is the transport a self-hosted install can actually have: SMTP_HOST
# alone activates it and the rest default sensibly — port 587, TLS negotiated
# with STARTTLS, no credential, EMAIL_FROM as the sender.
# SMTP_HOST=smtp.analytics.example
# SMTP_PORT=587
# Implicit TLS from the first byte. Set it for port 465; leave it unset for 587.
# Only the literals true and false are accepted.
# SMTP_SECURE=
# Both or neither — the transport authenticates only with a complete credential.
# SMTP_USER=
# SMTP_PASS=
# Overrides EMAIL_FROM for SMTP only, for relays that refuse a From that is not
# the authenticated mailbox.
# SMTP_FROM=

# The hosted alternative, and the one a self-hosted install usually cannot have:
# it needs a Resend account with a verified sending domain. Set with SMTP_HOST
# also set, this wins and the worker logs that it ignored the SMTP block.
# RESEND_API_KEY=

# Telegram notifications, if you want them. Without both halves the notification
# drain uses the log transport.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_NOTIFY_CHAT_ID=

# --- optional ---------------------------------------------------------------
# Ends a subscription when the account that owns it is erased. Only needed if
# you run Stripe billing. STRIPE_WEBHOOK_SECRET must NOT be set here.
# STRIPE_SECRET_KEY=

# Object storage for data import and export. All five or none.
# OBJECT_STORAGE_ENDPOINT=http://minio:9000
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_BUCKET=openanalytics
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=

# METRICS_REMOTE_WRITE_URL=
# METRICS_REMOTE_WRITE_USER=
# METRICS_REMOTE_WRITE_TOKEN=
