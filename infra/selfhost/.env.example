# Values docker compose itself interpolates. Copy to `.env` — or let
# `./generate-secrets.sh` write it — and edit the four hostnames.
#
# NO SECRETS LIVE HERE. Everything the application services read is in
# `env/*.env`, one file per service, because the per-service secret boundary
# means a shared environment would stop every service from booting.

# --- the four public names --------------------------------------------------
# All four must resolve to this host before the first start, or certificate
# issuance fails and nothing is served on 443.
OA_APP_HOST=app.analytics.example
OA_API_HOST=api.analytics.example
OA_COLLECTOR_HOST=c.analytics.example
OA_REALTIME_HOST=rt.analytics.example

# Contact address for the Let's Encrypt account. Expiry warnings go here.
OA_ACME_EMAIL=admin@analytics.example

# The three origins the dashboard's browser code calls are NOT here. They live
# in `env/web.env` with everything else that service reads: the image is built
# against placeholders and substitutes them at start, so they are ordinary
# run-time configuration rather than build arguments.

# --- network ----------------------------------------------------------------
# The two Valkey instances need fixed, provably-private addresses: the client
# factory rejects a plaintext queue URL to a host it cannot recognise as
# private, and a compose service name is not one. Any private range works.
# Change all three together, plus the URLs in env/*.env.
OA_SUBNET=172.28.0.0/16
OA_VALKEY_QUEUE_IP=172.28.0.10
OA_VALKEY_REALTIME_IP=172.28.0.11

# --- images -----------------------------------------------------------------
# Together these name every image: `${OA_IMAGE_REPO}/api:${OA_IMAGE_TAG}` and so
# on for all eight.
#
# As written below they name images no registry serves, so `docker compose up`
# builds them here — the behaviour a `git clone` of main has always had. To run
# a release instead, check out its tag and set both:
#
#   OA_IMAGE_REPO=ghcr.io/openlabs-so/openanalytics
#   OA_IMAGE_TAG=v0.1.0
#
# then `docker compose pull`. `./upgrade.sh` does this for you and takes a
# backup first. Keep the tag and the checkout the same version: the compose
# file, the env templates and the migrations ship with the images.
OA_IMAGE_REPO=openanalytics
OA_IMAGE_TAG=local
# Stamped into each image and published by `GET /health`, so you can ask a
# running service which commit it is. `git rev-parse HEAD` is the useful value.
# Only used when the images are built here; a pulled image carries the commit
# the release was built from.
OA_GIT_COMMIT=unknown
