# Keeps the build context to source and manifests.
#
# Without this the context is the whole working tree — node_modules, build
# output, the Next.js cache and the docs snapshot — which on a remote builder
# is both slow and unreliable enough to cancel the build outright.

.git/
node_modules/
**/node_modules/

# Rebuilt inside the image; copying stale output in would let a local build
# shadow what the Dockerfile actually compiles.
dist/
**/dist/
**/*.tsbuildinfo
.next/
**/.next/
coverage/
**/coverage/
.vitest/
.eslintcache

# Never let a local credential file reach a layer.
.env
.env.*
!.env.example

docs/
infra/
.github/

# Two exceptions, and they are the whole reason this file is not just a list of
# exclusions. `clickhouse.Dockerfile` and `valkey.Dockerfile` COPY out of
# `infra/selfhost/`, so the rule above hides their inputs from the build context
# and the build fails with `"/infra/selfhost/clickhouse/oa-entrypoint.sh": not
# found`, a message that points at the Dockerfile and not at the reason.
#
# The directory itself is re-included as well as its contents: an excluded
# directory is not descended into, so re-including only `**` under it finds
# nothing. Five small text files, and no other image reads them.
!infra/selfhost/clickhouse
!infra/selfhost/clickhouse/**
!infra/selfhost/valkey
!infra/selfhost/valkey/**
**/.DS_Store
**/Thumbs.db
